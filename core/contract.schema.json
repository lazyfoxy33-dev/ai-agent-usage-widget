{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lazyfoxy33-dev/ai-agent-usage-widget/blob/main/core/contract.schema.json",
  "title": "AI Agent Usage Widget payload",
  "type": "object",
  "required": ["schema_version", "claude", "codex", "kimi", "deepseek", "siliconflow", "openrouter"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "claude": {
      "$ref": "#/$defs/provider"
    },
    "codex": {
      "$ref": "#/$defs/provider"
    },
    "kimi": {
      "$ref": "#/$defs/provider"
    },
    "deepseek": {
      "$ref": "#/$defs/provider"
    },
    "siliconflow": {
      "$ref": "#/$defs/provider"
    },
    "openrouter": {
      "$ref": "#/$defs/provider"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "provider": {
      "type": "object",
      "required": ["ok", "fetched_at", "live"],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "fetched_at": {
          "type": ["integer", "null"]
        },
        "live": {
          "type": "boolean"
        },
        "kind": {
          "enum": ["quota", "balance"]
        },
        "reason": {
          "enum": ["expired", "error", "no_data", "stale", "rate_limited", "balance_unavailable"]
        },
        "upstream_reason": {
          "enum": ["expired", "error", "no_data", "rate_limited"]
        },
        "as_of": {
          "type": "integer"
        },
        "five_h": {
          "$ref": "#/$defs/window"
        },
        "weekly": {
          "$ref": "#/$defs/window"
        },
        "balance": {
          "$ref": "#/$defs/balance"
        },
        "burn_rate": {
          "$ref": "#/$defs/burn_rate"
        }
      },
      "additionalProperties": true
    },
    "balance": {
      "type": "object",
      "required": ["amount", "currency", "available", "label"],
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "burn_rate": {
      "type": "object",
      "required": ["confidence"],
      "properties": {
        "amount_per_day": {
          "type": "number"
        },
        "window_days": {
          "type": "integer"
        },
        "estimated_days_left": {
          "type": "integer"
        },
        "confidence": {
          "enum": ["none", "low", "medium", "high"]
        },
        "reason": {
          "enum": ["insufficient_history", "no_recent_spend", "balance_increased"]
        }
      },
      "additionalProperties": true
    },
    "window": {
      "type": "object",
      "required": ["pct", "resets_at"],
      "properties": {
        "pct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "resets_at": {
          "type": "integer"
        },
        "stale": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
